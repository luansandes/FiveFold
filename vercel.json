{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.py": {
      "maxDuration": 300,
      "excludeFiles": "{tests/**,**/test_*.py,.github/**,htmlcov/**}"
    },
    "api/queue_consumer.ts": {
      "maxDuration": 300,
      "experimentalTriggers": [
        {
          "type": "queue/v2beta",
          "topic": "fivefold-stage-ready",
          "retryAfterSeconds": 60,
          "initialDelaySeconds": 0
        }
      ]
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index"
    }
  ],
  "crons": [
    {
      "path": "/api/worker/tick",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/internal/reset-generated",
      "schedule": "28 13 * * *"
    }
  ]
}
